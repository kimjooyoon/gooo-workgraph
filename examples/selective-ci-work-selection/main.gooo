package selectiveciworkselection
namespace selectiveciworkselection

entity ImmutableInputDigest id "gooo://selective-ci-work-selection/entity/immutable-input-digest"
entity ToolchainDigest id "gooo://selective-ci-work-selection/entity/toolchain-digest"
entity ScenarioDigest id "gooo://selective-ci-work-selection/entity/scenario-digest"
entity PlannedTestEvidence id "gooo://selective-ci-work-selection/entity/planned-test"
entity ExecutedTestEvidence id "gooo://selective-ci-work-selection/entity/executed-test"
entity ReusedPriorReceiptEvidence id "gooo://selective-ci-work-selection/entity/reused-prior-receipt"
entity InvalidatedReceiptEvidence id "gooo://selective-ci-work-selection/entity/invalidated-receipt"
entity RequiredWorkEvidence id "gooo://selective-ci-work-selection/entity/required-work"
entity UnknownCausalFrontierEvidence id "gooo://selective-ci-work-selection/entity/unknown-causal-frontier"
entity ActualReceiptActivities id "gooo://selective-ci-work-selection/entity/meta-activities"
entity ExecutionReceiptAuthority id "gooo://selective-ci-work-selection/entity/execution-receipt-authority"
entity AlreadyTestedReport id "gooo://selective-ci-work-selection/entity/already-tested-report"
entity AlreadyTestedDecision id "gooo://selective-ci-work-selection/entity/decision"

activity PlannedTest(PlannedTestEvidence) -> AlreadyTestedDecision
activity ExecutedTest(ExecutedTestEvidence) -> AlreadyTestedDecision
activity ReusedPriorReceipt(ReusedPriorReceiptEvidence) -> AlreadyTestedDecision
activity InvalidatedReceipt(InvalidatedReceiptEvidence) -> AlreadyTestedDecision
activity RequiredWork(RequiredWorkEvidence) -> AlreadyTestedDecision
activity UnknownCausalFrontier(UnknownCausalFrontierEvidence) -> AlreadyTestedDecision
activity VerifyImmutableInputDigest(ImmutableInputDigest) -> AlreadyTestedDecision
activity VerifyToolchainDigest(ToolchainDigest) -> AlreadyTestedDecision
activity VerifyScenarioDigest(ScenarioDigest) -> AlreadyTestedDecision
activity BindActualReceiptActivities(ActualReceiptActivities) -> AlreadyTestedDecision
activity VerifyExecutionReceiptAuthority(ExecutionReceiptAuthority) -> AlreadyTestedDecision
activity PublishAlreadyTestedReport(AlreadyTestedReport) -> AlreadyTestedDecision
