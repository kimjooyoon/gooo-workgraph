package workgraph
namespace public_workgraph

entity PublicRepository id "workgraph://entity/public-repository"
entity GoooAuthority id "workgraph://entity/gooo-authority"
entity WorkgraphContract id "workgraph://entity/contract"
entity ContractRFC id "workgraph://entity/rfc"
entity PinnedCoreRelease id "workgraph://entity/pinned-core-release"
entity CoreBinaryLock id "workgraph://entity/core-binary-lock"
entity VersionReceipt id "workgraph://entity/version-receipt"
entity CheckReceipt id "workgraph://entity/check-receipt"
entity SourceHeadBinding id "workgraph://entity/source-head-binding"
entity RepositoryWriteObservation id "workgraph://entity/repository-write-observation"
entity InitialWorkgraphReport id "workgraph://entity/initial-report"
entity UnknownTraceReceipt id "workgraph://entity/unknown-trace"
entity ReadinessDecision id "workgraph://entity/readiness-decision"

activity ObservePublicRepository(PublicRepository) -> ReadinessDecision
activity DeclareGoooAuthority(GoooAuthority) -> ReadinessDecision
activity VersionWorkgraphContract(WorkgraphContract) -> ReadinessDecision
activity PublishContractRFC(ContractRFC) -> ReadinessDecision
activity ObserveCoreRelease(PinnedCoreRelease) -> ReadinessDecision
activity LockCoreBinaryDigest(PinnedCoreRelease) -> CoreBinaryLock
activity ExecuteReleasedVersion(CoreBinaryLock) -> VersionReceipt
activity ExecuteReleasedCheck(VersionReceipt) -> CheckReceipt
activity BindSourceHead(CheckReceipt) -> SourceHeadBinding
activity ObserveRepositoryWrites(SourceHeadBinding) -> RepositoryWriteObservation
activity ObserveInitialReport(RepositoryWriteObservation) -> InitialWorkgraphReport
activity PreserveUnknownTrace(InitialWorkgraphReport) -> UnknownTraceReceipt
